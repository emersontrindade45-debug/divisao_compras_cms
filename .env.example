# Banco de dados
# Em produção, usar URL com sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/divisao_compras?schema=public"

# Conexão direta (não-pooled) — lida por prisma.config.ts (datasource.url) e
# usada apenas pelo CLI do Prisma (`migrate deploy`/`migrate status`, rota
# /api/admin/migrate). A app usa DATABASE_URL via adapter em src/lib/db.ts,
# independentemente disso. Se o DATABASE_URL já for uma conexão direta (ex.:
# dev local), repita o mesmo valor aqui.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/divisao_compras?schema=public"

# Autenticação (gerar com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio-min-32-chars"

# E-mail — Resend (https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM="pesquisa@cms.santos.sp.gov.br"

# E-mail do responsável da divisão (usado em lembretes como reply-to)
EMAIL_RESPONSAVEL="compras@cms.santos.sp.gov.br"

# Cron Job — segredo para proteger /api/jobs/lembretes (gere com: openssl rand -hex 32)
CRON_SECRET=""

# Migrations de produção — segredo para proteger /api/admin/migrate (gere com:
# openssl rand -hex 32). Sem este valor a rota fica fechada (fail-closed).
ADMIN_MIGRATE_SECRET=""

# Storage — Vercel Blob (opcional; usar armazenamento local se não disponível)
BLOB_READ_WRITE_TOKEN=""

# Google Sheets (opcional — integração de sincronização de objetos)
NEXT_PUBLIC_SHEETS_URL=""
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""

# URL pública do app (necessário para links em e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI (pesquisa por similaridade — extração de TR e ranking; único provedor de IA
# em produção, decisão M11) — obter em https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Google Sheets — Service Account para preenchimento automático da planilha de
# cotação (mediana). Criar em https://console.cloud.google.com (IAM e Administrador
# > Contas de serviço > Chaves > Criar chave JSON), compartilhar a planilha modelo
# com o client_email da conta como Editor, e colar o JSON inteiro em uma linha aqui.
GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY=""

# ID da planilha modelo de cotação (mediana) — extraído da URL do Google Sheets
GOOGLE_SHEETS_PLANILHA_MODELO_ID=""

# CNPJ do próprio órgão (Câmara Municipal de Santos). Contratações com este CNPJ são
# excluídas das buscas de similaridade (PNCP): um contrato do próprio órgão não pode
# servir de referência de preço para sua própria renovação/prorrogação (IN 65/2021).
# Aceita com ou sem máscara. Se não definido, usa o valor abaixo como padrão — a regra
# de conformidade vale mesmo sem a variável no ambiente.
ORGAO_CNPJ="49203409000102"

# Testes E2E (usuário criado pelo seed com papel aprovacao)
E2E_EMAIL=admin@cms.gov.br
E2E_PASSWORD=teste123
