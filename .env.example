# Banco de dados
# Em produção, usar URL com sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/divisao_compras?schema=public"

# Autenticação (gerar com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio-min-32-chars"

# E-mail — Resend (https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM="pesquisa@cms.santos.sp.gov.br"

# E-mail do responsável da divisão (usado em lembretes como reply-to)
EMAIL_RESPONSAVEL="compras@cms.santos.sp.gov.br"

# Cron Job — segredo para proteger /api/jobs/lembretes (gere com: openssl rand -hex 32)
CRON_SECRET=""

# Storage — Vercel Blob (opcional; usar armazenamento local se não disponível)
BLOB_READ_WRITE_TOKEN=""

# Google Sheets (opcional — integração de sincronização de objetos)
NEXT_PUBLIC_SHEETS_URL=""
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""

# URL pública do app (necessário para links em e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Testes E2E (usuário criado pelo seed com papel aprovacao)
E2E_EMAIL=admin@cms.gov.br
E2E_PASSWORD=teste123
