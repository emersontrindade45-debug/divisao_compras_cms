generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  pesquisa
  revisao
  aprovacao
}

enum StatusProcesso {
  aderente
  parcial
  nao_aderente
  pendente
}

enum ClassificacaoItem {
  comum
  especifico
}

// Natureza do objeto pesquisado — determina a janela de validade de uma
// contratação pública homologada como referência de preço (18 meses para
// serviço contínuo, 12 meses para bem de consumo). Eixo diferente de
// `ClassificacaoItem` (que é sobre catálogo/SICAF, não sobre a natureza do
// objeto). Nullable no model: item sem classificação usa o teto mais
// permissivo (ver `in65Rules.ts`) até alguém classificar manualmente.
enum NaturezaObjeto {
  bem_consumo
  servico_continuo
}

enum TipoFonte {
  contratacao_publica
  site_eletronico
  fornecedor_direto
}

enum TipoCandidatoSimilaridade {
  contratacao_publica
  painel_precos
  // Achado pelo assistente (M13) numa busca na web aberta. NÃO é promovível a
  // Fonte pelo fluxo de similaridade: evidência de site exige data/hora do
  // acesso real e arquivo capturado (IN 65/2021), o que só o módulo de sites
  // (CapturaEvidencia) produz. Ver `podePromoverCandidato` em
  // src/lib/domain/tipoFonteSimilaridade.ts.
  site_eletronico
  // Candidato originado de uma tabela de referência ingerida (SINAPI, CADTERC,
  // CATMAT, ...; M15+). Um único valor para todas as fontes de referência de
  // propósito — a fonte concreta é identificada pela FK
  // `PrecoReferencia.fonteReferenciaId`, não por um valor de enum por fonte.
  // Ver docs/ApiPlan.md §3.3: cada valor novo custaria migration + varredura
  // de `select` (CLAUDE.md §9.46) + badge de UI + testes a cada fonte
  // ingerida; com um valor só, acrescentar a sexta fonte é inserir uma linha
  // em `FonteReferencia`, não migrar o schema.
  preco_referencia
}

// Esfera de governo responsável pela publicação de uma FonteReferencia —
// determina o peso da fonte na hierarquia de conformidade da IN 65/2021
// (ex.: SINAPI é referência federal; CADTERC é estadual e pode exigir
// justificativa adicional — ver docs/ApiPlan.md M17/M18).
enum EsferaGoverno {
  federal
  estadual
  municipal
}

/**
 * Como o candidato de similaridade entrou na base (M13).
 */
enum OrigemResultado {
  pipeline_automatico
  assistente
}

enum PapelMensagem {
  user
  assistant
  tool
}

/**
 * Nível em que uma instrução de pesquisa se aplica (M13).
 */
enum EscopoInstrucaoPesquisa {
  global
  categoria
  processo
}

enum AderenciaFonte {
  aderente
  parcial
  nao_aderente
}

enum ListaSite {
  branca
  cinza
  vermelha
}

enum StatusCotacao {
  positiva
  negativa
  incompleta
  silenciosa
}

enum StatusChecklist {
  valido
  ressalva
  invalido
}

enum StatusGeral {
  valida
  com_ressalva
  invalida
}

enum MetodoConsolidacao {
  media
  mediana
  menor_valor
}

enum StatusPreco {
  incluido
  excluido
}

enum StatusFornecedor {
  ativo
  inativo
}

enum StatusResposta {
  respondido
  nao_respondido
  recusado
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(pesquisa)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  conversas          ConversaAssistente[]
  instrucoesPesquisa InstrucaoPesquisa[]

  @@map("users")
}

model Processo {
  id                      String            @id @default(cuid())
  numero                  String            @unique
  objeto                  String
  unidade                 String
  quantidade              Int
  caracteristicasTecnicas String
  palavrasChave           String[]
  classificacao           ClassificacaoItem
  responsavel             String
  status                  StatusProcesso    @default(pendente)
  dataAbertura            DateTime
  planilhaOrigemUrl       String?
  // JSON serializado de ContextoTR: tabelaItens, modeloExecucao, materiaisEquipamentos.
  // Preenchido quando o TR é processado; permanece como referência permanente para o assistente.
  trContexto              String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  itens        Item[]
  contratacoes ContratacaoPublica[]
  capturas     CapturaEvidencia[]
  cotacoes     Cotacao[]
  auditLogs    AuditLog[]

  conversas          ConversaAssistente[]
  instrucoesPesquisa InstrucaoPesquisa[]

  @@map("processos")
}

model Item {
  id                      String            @id @default(cuid())
  processoId              String
  descricao               String
  unidade                 String
  quantidade              Int
  classificacao           ClassificacaoItem
  // Nullable de propósito: ver comentário do enum `NaturezaObjeto`.
  natureza                NaturezaObjeto?
  caracteristicasTecnicas String?
  palavrasChave           String[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  processo               Processo                @relation(fields: [processoId], references: [id], onDelete: Cascade)
  fontes                 Fonte[]
  seriePrecos            SeriePreco[]
  resultadosSimilaridade ResultadoSimilaridade[]

  @@map("itens")
}

model ResultadoSimilaridade {
  id                     String                    @id @default(cuid())
  itemId                 String
  tipoCandidato          TipoCandidatoSimilaridade
  fonteDescricao         String
  fonteOrgaoOuId         String
  fonteUrl               String?
  valorUnitario          Decimal                   @db.Decimal(12, 2)
  dataReferencia         DateTime
  scoreFinal             Decimal                   @db.Decimal(5, 2)
  scoreDescricao         Decimal                   @db.Decimal(5, 2)
  scoreEspecificacao     Decimal                   @db.Decimal(5, 2)
  scoreUnidadeQuantidade Decimal                   @db.Decimal(5, 2)
  adaptado               Boolean                   @default(false)
  justificativa          String
  promovidoParaFonte     Boolean                   @default(false)
  // Descartado manualmente pelo usuário na lista de resultados (não entra mais
  // em obterFontesSimilaridade). Reaparece se uma nova busca recriar as linhas.
  descartado             Boolean                   @default(false)
  // Origem do candidato (M13). O default mantém válidas as linhas gravadas pelo
  // pipeline automático antes desta migration.
  origem                 OrigemResultado           @default(pipeline_automatico)
  // Conversa que gerou o candidato — só preenchido quando origem = assistente.
  conversaId             String?
  // Termo efetivamente usado na busca que achou este candidato. Alimenta a
  // análise de quais termos produzem candidatos que viram Fonte.
  termoBuscaUsado        String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  item     Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fonte    Fonte?
  conversa ConversaAssistente? @relation(fields: [conversaId], references: [id], onDelete: SetNull)

  @@index([conversaId])
  @@map("resultados_similaridade")
}

model Fonte {
  id                      String      @id @default(cuid())
  itemId                  String
  tipo                    TipoFonte
  descricao               String
  orgaoOuFornecedor       String
  dataReferencia          DateTime
  valorUnitario           Decimal     @db.Decimal(12, 2)
  status                  StatusPreco @default(incluido)
  motivoExclusao          String?
  // Origem: preenchido só quando a Fonte nasce da promoção de um candidato de
  // similaridade. @unique impede duas Fontes do mesmo candidato (backstop de
  // banco contra promoção concorrente); nulo para Fontes de outros fluxos, e o
  // Postgres permite múltiplos nulos.
  resultadoSimilaridadeId String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  item                  Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resultadoSimilaridade ResultadoSimilaridade? @relation(fields: [resultadoSimilaridadeId], references: [id], onDelete: SetNull)
  evidencias            Evidencia[]

  @@map("fontes")
}

model Evidencia {
  id             String   @id @default(cuid())
  fonteId        String
  arquivo        String?
  url            String?
  dataHoraAcesso DateTime
  descricao      String?
  createdAt      DateTime @default(now())

  fonte Fonte @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@map("evidencias")
}

model ContratacaoPublica {
  id                     String         @id @default(cuid())
  processoId             String
  numero                 String
  orgao                  String
  objeto                 String
  modalidade             String
  valorUnitario          Decimal        @db.Decimal(12, 2)
  quantidade             Int
  unidade                String
  dataContratacao        DateTime
  fonteUrl               String?
  aderencia              AderenciaFonte
  justificativaAderencia String?
  palavrasChave          String[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@map("contratacoes_publicas")
}

model Site {
  id            String    @id @default(cuid())
  url           String    @unique
  nome          String
  lista         ListaSite
  motivo        String?
  categoria     String
  isMarketplace Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  capturas CapturaEvidencia[]

  @@map("sites")
}

model CapturaEvidencia {
  id             String   @id @default(cuid())
  siteId         String
  processoId     String
  url            String
  produto        String
  valorUnitario  Decimal  @db.Decimal(12, 2)
  dataHoraAcesso DateTime
  evidencia      String?
  createdAt      DateTime @default(now())

  site     Site     @relation(fields: [siteId], references: [id])
  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@map("capturas_evidencias")
}

model Fornecedor {
  id                 String           @id @default(cuid())
  cnpj               String           @unique
  razaoSocial        String
  nomeFantasia       String?
  categoria          String[]
  cidade             String
  estado             String
  responsavelContato String
  email              String
  telefone           String?
  score              Int              @default(0)
  totalCotacoes      Int              @default(0)
  totalRespostas     Int              @default(0)
  taxaResposta       Decimal          @default(0) @db.Decimal(5, 2)
  ultimaResposta     DateTime?
  status             StatusFornecedor @default(ativo)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  cotacoes          Cotacao[]
  historicoCotacoes HistoricoCotacao[]

  @@map("fornecedores")
}

model HistoricoCotacao {
  id             String         @id @default(cuid())
  fornecedorId   String
  processoNumero String
  data           DateTime
  statusResposta StatusResposta
  valorProposto  Decimal?       @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@map("historico_cotacoes")
}

model Cotacao {
  id              String        @id @default(cuid())
  processoId      String
  fornecedorId    String
  dataEnvio       DateTime
  dataLimite      DateTime
  status          StatusCotacao @default(silenciosa)
  lembreteEnviado Boolean       @default(false)
  valorProposto   Decimal?      @db.Decimal(12, 2)
  observacao      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  processo   Processo   @relation(fields: [processoId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  proposta   Proposta?
  auditLogs  AuditLog[]

  @@map("cotacoes")
}

model Proposta {
  id                  String          @id @default(cuid())
  cotacaoId           String          @unique
  cnpjValido          StatusChecklist
  descricaoValida     StatusChecklist
  valorUnitarioValido StatusChecklist
  valorTotalValido    StatusChecklist
  dataValida          StatusChecklist
  responsavelValido   StatusChecklist
  statusGeral         StatusGeral
  valorUnitario       Decimal?        @db.Decimal(12, 2)
  valorTotal          Decimal?        @db.Decimal(12, 2)
  dataProposta        DateTime?
  responsavel         String?
  observacoes         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  cotacao Cotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)

  @@map("propostas")
}

model SeriePreco {
  id                  String             @id @default(cuid())
  itemId              String
  metodo              MetodoConsolidacao
  valorEstimado       Decimal            @db.Decimal(12, 2)
  media               Decimal            @db.Decimal(12, 2)
  mediana             Decimal            @db.Decimal(12, 2)
  menorValor          Decimal            @db.Decimal(12, 2)
  coeficienteVariacao Decimal            @db.Decimal(6, 2)
  totalPrecos         Int
  precosIncluidos     Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  item   Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  precos PrecoConsolidado[]

  @@map("series_precos")
}

model PrecoConsolidado {
  id                String      @id @default(cuid())
  seriePrecoId      String
  fonte             TipoFonte
  descricaoFonte    String
  fornecedorOuOrgao String
  dataReferencia    DateTime
  valorUnitario     Decimal     @db.Decimal(12, 2)
  status            StatusPreco @default(incluido)
  motivoExclusao    String?
  createdAt         DateTime    @default(now())

  seriePreco SeriePreco @relation(fields: [seriePrecoId], references: [id], onDelete: Cascade)

  @@map("precos_consolidados")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  processoId String?
  cotacaoId  String?
  acao       String
  detalhes   Json?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  processo Processo? @relation(fields: [processoId], references: [id])
  cotacao  Cotacao?  @relation(fields: [cotacaoId], references: [id])

  @@map("audit_logs")
}

// ─── Assistente de pesquisa (M13) ────────────────────────────────────────────

/**
 * Conversa com o assistente de pesquisa. `processoId` nulo é o que distingue a
 * conversa global (atalho da Topbar) da conversa ancorada num processo.
 */
model ConversaAssistente {
  id         String   @id @default(cuid())
  processoId String?
  userId     String
  titulo     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  processo   Processo?               @relation(fields: [processoId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id])
  mensagens  MensagemAssistente[]
  candidatos ResultadoSimilaridade[]

  @@index([processoId])
  @@index([userId])
  @@map("conversas_assistente")
}

model MensagemAssistente {
  id                String        @id @default(cuid())
  conversaId        String
  papel             PapelMensagem
  conteudo          String
  // Rastro das ferramentas usadas no turno: [{ ferramenta, argumentos,
  // resumoResultado, duracaoMs }]. É o que a UI mostra como "passos" e o que
  // permite auditar de qual fonte veio cada afirmação da IA.
  ferramentasUsadas Json?
  // [{ url, titulo, data }] das buscas web. Nunca vira Evidencia sozinho.
  citacoes          Json?
  modelo            String?
  tokensEntrada     Int?
  tokensSaida       Int?
  createdAt         DateTime      @default(now())

  conversa ConversaAssistente @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("mensagens_assistente")
}

/**
 * Regras de pesquisa escritas pelos servidores para o assistente melhorar as
 * buscas de similaridade. Aplicadas em três níveis, concatenadas nesta ordem:
 * global → categoria do item → processo aberto.
 * `chave` existe porque `@@unique([escopo, categoria, processoId])` NÃO
 * garantiria unicidade: no Postgres, NULL é distinto de NULL, e dois registros
 * globais (ambos com categoria/processoId nulos) passariam pela constraint.
 * A chave textual ("global", "categoria:mobiliario", "processo:<id>") torna a
 * unicidade verificável pelo banco, não por checagem em código (CLAUDE.md §9.14).
 */
model InstrucaoPesquisa {
  id              String                  @id @default(cuid())
  escopo          EscopoInstrucaoPesquisa
  categoria       String?
  processoId      String?
  chave           String                  @unique
  conteudo        String
  versao          Int                     @default(1)
  ativo           Boolean                 @default(true)
  atualizadoPorId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  processo      Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  atualizadoPor User      @relation(fields: [atualizadoPorId], references: [id])

  @@index([escopo])
  @@index([processoId])
  @@map("instrucoes_pesquisa")
}

// ─── Repositório de inteligência de mercado (Módulo 8 do PRD; M15+) ─────────
//
// Fundação da ingestão de tabelas de referência de preço (SINAPI, CADTERC,
// CATMAT, ...). Nenhuma fonte real é povoada em M15 — só o esqueleto de
// catálogo + auditoria de lote + registro de preço (docs/ApiPlan.md §3.2).

/**
 * Catálogo das fontes de referência ingeridas (SINAPI, CADTERC, CATMAT, ...).
 */
model FonteReferencia {
  id            String        @id @default(cuid())
  /**
   * Identificador estável usado pelo runner de ingestão e pelo código (ex.: "sinapi").
   */
  chave         String        @unique
  nome          String
  esfera        EsferaGoverno
  /**
   * Enquadramento legal que justifica o uso da fonte como referência de preço (IN 65/2021).
   */
  baseLegal     String?
  urlOficial    String
  /**
   * Texto livre de propósito: periodicidade real varia por fonte e algumas são "esporádicas" (ver docs/ApiPlan.md §2.5).
   */
  periodicidade String
  ativa         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lotes  LoteIngestao[]
  precos PrecoReferencia[]

  @@map("fontes_referencia")
}

/**
 * Auditoria de uma rodada de ingestão de uma FonteReferencia.
 */
model LoteIngestao {
  id                String    @id @default(cuid())
  fonteReferenciaId String
  /**
   * Competência do lote (ex.: "2026-08" para publicação mensal).
   */
  competencia       String
  urlArquivo        String
  checksum          String
  linhasLidas       Int       @default(0)
  linhasImportadas  Int       @default(0)
  linhasRejeitadas  Int       @default(0)
  iniciadoEm        DateTime  @default(now())
  concluidoEm       DateTime?
  /**
   * Preenchido quando o runner rejeita o lote inteiro (ex.: cabeçalho inesperado).
   */
  erro              String?

  fonteReferencia FonteReferencia   @relation(fields: [fonteReferenciaId], references: [id], onDelete: Cascade)
  precos          PrecoReferencia[]

  @@index([fonteReferenciaId])
  @@map("lotes_ingestao")
}

/**
 * Registro de preço de uma fonte de referência ingerida.
 * `competencia` é duplicada de `LoteIngestao` (não só herdada por relação):
 * assim uma consulta por competência não precisa de join, e o histórico de
 * competências de um código permanece íntegro mesmo que o lote de origem seja
 * reprocessado. `uf` usa `""` como sentinela de "âmbito nacional" em vez de
 * `null` — no Postgres, `NULL` é sempre distinto de `NULL` em constraint
 * `@@unique`, então uma fonte nacional (sem UF) poderia duplicar o mesmo
 * código na mesma competência sem violar a constraint (mesma armadilha da
 * nota em `InstrucaoPesquisa.chave`).
 */
model PrecoReferencia {
  id                   String   @id @default(cuid())
  fonteReferenciaId    String
  loteIngestaoId       String
  codigo               String
  descricao            String
  descricaoNormalizada String
  unidade              String
  valorUnitario        Decimal  @db.Decimal(12, 2)
  competencia          String
  dataReferencia       DateTime
  /**
   * "" = âmbito nacional (ver nota acima); UF de duas letras quando a fonte é regional.
   */
  uf                   String   @default("")
  urlEvidencia         String?
  metadados            Json?
  createdAt            DateTime @default(now())

  fonteReferencia FonteReferencia @relation(fields: [fonteReferenciaId], references: [id], onDelete: Cascade)
  loteIngestao    LoteIngestao    @relation(fields: [loteIngestaoId], references: [id], onDelete: Cascade)

  @@unique([fonteReferenciaId, codigo, competencia, uf])
  @@index([fonteReferenciaId, competencia])
  @@index([descricaoNormalizada])
  @@map("precos_referencia")
}
